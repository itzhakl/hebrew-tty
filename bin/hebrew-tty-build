#!/usr/bin/env bash
# Build the Hebrew build of whatever version `claude` points at now.
#
# The filter does not repair rows yet, so the Hebrew on screen still comes out
# of tools/patch-binary.py. Claude upgrades itself, and the shell function
# picks the patched build by name, so something has to make one after an
# upgrade. That never happens in front of anyone: the session that finds the
# build missing runs what it has and leaves this working behind it.
#
# The original executable is never written to, and a build that starts but
# leaves Hebrew unaligned is thrown away rather than installed - the patcher
# decides that, not this script.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
patcher="$here/../tools/patch-binary.py"

claude="${1:-$HOME/.local/bin/claude}"
if [ ! -e "$claude" ]; then
  echo "hebrew-tty-build: no claude at $claude" >&2
  exit 1
fi

# `claude` may already point at a patched build; always derive from the stock one.
base="$(readlink -f "$claude")"
base="${base%-rtl}"
out="$base-rtl"

if [ -x "$out" ] && [ ! "$base" -nt "$out" ]; then
  echo "hebrew-tty-build: $(basename "$out") is up to date"
  exit 0
fi

# mkdir is the atomic part; a lock left behind by a killed build would
# otherwise mean no rebuild ever happens again.
lock="$out.building"
if ! mkdir "$lock" 2>/dev/null; then
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then
    # Half an hour is far longer than a build takes, so this one is not running.
    rm -rf "$lock"
    mkdir "$lock"
  else
    echo "hebrew-tty-build: a build is already running" >&2
    exit 0
  fi
fi
trap 'rm -rf "$lock"' EXIT

if python3 "$patcher" "$base" "$out.new"; then
  mv -f "$out.new" "$out"
  echo "hebrew-tty-build: $(basename "$out")"
else
  rm -f "$out.new"
  echo "hebrew-tty-build: $(basename "$base") did not patch" >&2
  exit 1
fi

# A build whose stock version is gone is dead weight.
for old in "$(dirname "$base")"/*-rtl; do
  if [ -e "$old" ] && [ ! -e "${old%-rtl}" ]; then
    rm -f "$old"
  fi
done
