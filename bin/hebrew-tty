#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case $link in
    /*) script_path=$link ;;
    *) script_path=$(dirname -- "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)

if [ -n "${HEBREW_TTY_BIN:-}" ]; then
  binary=$HEBREW_TTY_BIN
elif [ -x "$script_dir/../target/release/hebrew-tty" ]; then
  binary=$script_dir/../target/release/hebrew-tty
elif [ -x "$script_dir/../target/debug/hebrew-tty" ]; then
  binary=$script_dir/../target/debug/hebrew-tty
elif [ -x "$script_dir/../dist/hebrew-tty-linux-x86_64" ]; then
  binary=$script_dir/../dist/hebrew-tty-linux-x86_64
else
  binary=$(command -v hebrew-tty || true)
fi

case $binary in
  */*) resolved_binary=$binary ;;
  *) resolved_binary=$(command -v "$binary" || true) ;;
esac
if [ -z "$resolved_binary" ] || [ "$resolved_binary" -ef "$script_dir/hebrew-tty" ]; then
  echo "hebrew-tty: Rust binary not found; run cargo build --release" >&2
  exit 127
fi

exec "$binary" "$@"
